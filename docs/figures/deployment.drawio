<mxfile host="app.diagrams.net"><diagram name="Deployment" id="deploy"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="420"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="store" value="&lt;b&gt;Object storage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;new video lands&lt;br&gt;(S3 / GCS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#f2f2f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="150" height="70" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b&gt;Event queue&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;SQS / Kafka&lt;br&gt;one msg per video&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#f2f2f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="150" height="70" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;Classifier workers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2457d6;fillColor=#e8eefb;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="300" height="230" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1. moov index via range read&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;metadata + packet sizes, ~0.1 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2457d6;fillColor=#ffffff;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="60" width="270" height="36" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. four 8 s audio clips&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;VAD speech ratio + loudness, ~0.2 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2457d6;fillColor=#ffffff;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="104" width="270" height="36" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3. sixteen frame seeks&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;MobileCLIP2-S0 (ONNX), ~0.9 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2457d6;fillColor=#ffffff;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="148" width="270" height="36" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. classifier (1 MB)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;class, probabilities, confidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2457d6;fillColor=#ffffff;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="192" width="270" height="36" as="geometry"/></mxCell><mxCell id="router" value="&lt;b&gt;Chunking router&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;conf &amp;gt;= 0.5: class chunker&lt;br&gt;else: fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2f7d32;fillColor=#e7f3e8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="40" width="150" height="70" as="geometry"/></mxCell><mxCell id="chunkers" value="&lt;b&gt;Chunkers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;8 strategies + fallback&lt;br&gt;(shots, transcript, events,&lt;br&gt;motion, HUD ...)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2f7d32;fillColor=#e7f3e8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="30" width="170" height="90" as="geometry"/></mxCell><mxCell id="index" value="&lt;b&gt;Video index&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;extraction + retrieval&lt;br&gt;(downstream team)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#f2f2f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="160" width="170" height="60" as="geometry"/></mxCell><mxCell id="meta" value="&lt;b&gt;Metadata store&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;class, probs, features,&lt;br&gt;latency per video&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#f2f2f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="160" width="150" height="60" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b&gt;Audit sample&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;1% random + all low-confidence;&lt;br&gt;VLM teacher drafts a label&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#b4560b;fillColor=#fcefe3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="180" height="70" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;Human review&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;same review page&lt;br&gt;used for training labels&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#b4560b;fillColor=#fcefe3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="300" width="150" height="70" as="geometry"/></mxCell><mxCell id="retrain" value="&lt;b&gt;Retrain + gate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;grouped CV must not drop;&lt;br&gt;minutes on one CPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#b4560b;fillColor=#fcefe3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="300" width="145" height="70" as="geometry"/></mxCell><mxCell id="registry" value="&lt;b&gt;Model registry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;canary on 5% of&lt;br&gt;workers first&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#b4560b;fillColor=#fcefe3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="145" height="70" as="geometry"/></mxCell><mxCell id="monitor" value="&lt;b&gt;Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;class mix vs last 7 days, confidence histogram,&lt;br&gt;fallback rate, p95 latency, decode errors.&lt;br&gt;Alert when the fallback rate doubles or a class&lt;br&gt;share moves by more than 10 points.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#f2f2f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="330" height="90" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;strokeColor=#555555;fontColor=#555555;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="store" target="queue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;strokeColor=#555555;fontColor=#555555;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="queue" target="worker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;strokeColor=#2457d6;fontColor=#2457d6;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="worker" target="router"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;strokeColor=#2f7d32;fontColor=#2f7d32;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="router" target="chunkers"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="chunks" style="endArrow=block;html=1;strokeColor=#2f7d32;fontColor=#2f7d32;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="chunkers" target="index"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;strokeColor=#2457d6;fontColor=#2457d6;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="worker" target="meta"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="sampled" style="endArrow=block;html=1;strokeColor=#b4560b;fontColor=#b4560b;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="meta" target="audit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="272"/><mxPoint x="970" y="272"/></Array></mxGeometry></mxCell><mxCell id="e7" value="" style="endArrow=block;html=1;strokeColor=#b4560b;fontColor=#b4560b;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="audit" target="review"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="endArrow=block;html=1;strokeColor=#b4560b;fontColor=#b4560b;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="review" target="retrain"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="endArrow=block;html=1;strokeColor=#b4560b;fontColor=#b4560b;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="retrain" target="registry"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="new model" style="endArrow=block;html=1;strokeColor=#b4560b;fontColor=#b4560b;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="registry" target="worker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="endArrow=block;html=1;strokeColor=#555555;fontColor=#555555;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="worker" target="monitor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>